{
  "name": "vocal-stack",
  "version": "2.0.0",
  "description": "Provider-neutral text, interruption, telemetry, and testing reliability for TypeScript voice pipelines",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sanitizer": {
      "import": {
        "types": "./dist/sanitizer/index.d.ts",
        "default": "./dist/sanitizer/index.js"
      },
      "require": {
        "types": "./dist/sanitizer/index.d.cts",
        "default": "./dist/sanitizer/index.cjs"
      }
    },
    "./flow": {
      "import": {
        "types": "./dist/flow/index.d.ts",
        "default": "./dist/flow/index.js"
      },
      "require": {
        "types": "./dist/flow/index.d.cts",
        "default": "./dist/flow/index.cjs"
      }
    },
    "./monitor": {
      "import": {
        "types": "./dist/monitor/index.d.ts",
        "default": "./dist/monitor/index.js"
      },
      "require": {
        "types": "./dist/monitor/index.d.cts",
        "default": "./dist/monitor/index.cjs"
      }
    },
    "./text": {
      "import": {
        "types": "./dist/text/index.d.ts",
        "default": "./dist/text/index.js"
      },
      "require": {
        "types": "./dist/text/index.d.cts",
        "default": "./dist/text/index.cjs"
      }
    },
    "./turn": {
      "import": {
        "types": "./dist/turn/index.d.ts",
        "default": "./dist/turn/index.js"
      },
      "require": {
        "types": "./dist/turn/index.d.cts",
        "default": "./dist/turn/index.cjs"
      }
    },
    "./telemetry": {
      "import": {
        "types": "./dist/telemetry/index.d.ts",
        "default": "./dist/telemetry/index.js"
      },
      "require": {
        "types": "./dist/telemetry/index.d.cts",
        "default": "./dist/telemetry/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:recipes": "tsc -p tsconfig.recipes.json",
    "check": "npm run lint && npm run typecheck && npm run typecheck:recipes && npm run test:coverage && npm run build && npm run package:check && npm run package:size && npm run examples:check",
    "package:check": "publint && attw --pack . --profile node16 && node scripts/package-smoke.mjs",
    "package:size": "node scripts/check-package-size.mjs",
    "benchmark": "npm run build && node benchmarks/text.mjs",
    "examples:check": "node scripts/check-examples.mjs",
    "prepublishOnly": "npm run check",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "voice-ai",
    "tts",
    "llm",
    "streaming",
    "speech",
    "conversational-ai",
    "realtime",
    "latency",
    "voice-agents",
    "text-to-speech",
    "ai-agents",
    "openai",
    "elevenlabs"
  ],
  "author": "Gaurav <gauravchaulagain0@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaurav890/vocal-stack.git"
  },
  "bugs": {
    "url": "https://github.com/gaurav890/vocal-stack/issues"
  },
  "homepage": "https://github.com/gaurav890/vocal-stack#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^3.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "ai": "^7.0.99",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
